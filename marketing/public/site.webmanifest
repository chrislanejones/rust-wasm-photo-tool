{
  "name": "Image Horse",
  "short_name": "Image Horse",
  "description": "A browser image editor built in Rust and shipped as WebAssembly. Editing runs on your own machine.",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "background_color": "#1b1210",
