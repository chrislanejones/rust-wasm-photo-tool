{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    // No `baseUrl`, and the path is RELATIVE. TypeScript 7 removed `baseUrl`
    // (TS5102) and rejects a non-relative path target (TS5090), and this file
    // was the only tsconfig in the repo still using either — app/tsconfig.json
    // already writes "./src/*". Without `baseUrl`, paths resolve against this
    // file's own directory, which is where "." pointed anyway, so the mapping
    // is unchanged for TypeScript 5. Runtime resolution never read this block:
    // `@` is aliased in marketing/vite.config.ts.
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
