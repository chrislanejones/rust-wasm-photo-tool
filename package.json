{
  "name": "rust-wasm-photo-tool",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "pnpm --filter stamp-tool dev",
    "dev:marketing": "pnpm --filter photo-horse-marketing dev",
    "build": "pnpm --filter stamp-tool build",
    "build:marketing": "pnpm --filter photo-horse-marketing build",
    "build:wasm": "./scripts/build-wasm.sh",
    "bench:annotations": "node scripts/annotation-benchmark.mjs",
    "bench:compare": "node scripts/compare-benchmark.mjs",
    "build:all": "pnpm run build:wasm && pnpm run build",
    "lint": "eslint app/src eslint.config.mjs",
    "lint:fix": "eslint app/src eslint.config.mjs --fix",
    "test:convex": "node --test scripts/convex-deploy-check.test.mjs && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:sw": "playwright test --config playwright.sw.config.ts",
    "test:e2e:nokeys": "playwright test --config playwright.nokeys.config.ts",
    "wipe:test-account": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/wipe-test-account.mjs"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "26.6.4",
    "convex": "catalog:",
    "convex-test": "^0.0.62",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
